{
  "name": "page-health-monitor",
  "version": "1.0.0",
  "description": "Comprehensive Web Page Health, Asset, Link, Font, API & Redirection Auditor",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "tsx src/index.ts",
    "audit": "tsx src/index.ts",
    "clean": "tsx src/index.ts --clean",
    "clean:reports": "tsx src/index.ts --clean",
    "docs:word": "tsx scripts/generateDocx.ts",
    "ui": "tsx scripts/serveUi.ts",
    "serve": "tsx scripts/serveUi.ts"
  },
  "keywords": [
    "audit",
    "page-checker",
    "playwright",
    "broken-links",
    "broken-images",
    "api-monitor",
    "font-checker",
    "redirection-tracer"
  ],
  "author": "",
